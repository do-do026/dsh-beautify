{
  "name": "@local/dsh-beautify",
  "version": "1.0.0",
  "private": true,
  "description": "Client-side beautification bundle for the DSH desktop app: backdrop, water-glass material, bubbles, avatars, a character card in the right pane, and a click-through floating portrait.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/do-do026/dsh-beautify.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bundle",
    "theme",
    "beautify"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
